// Mechanic System — database schema (spec §17)
// Conventions:
//  - Money is ALWAYS integer cents (Int) — never float (spec §18)
//  - Soft delete via deletedAt + active flag on catalogs (spec §34)
//  - Historical snapshots live on work order items (spec §35)
//  - Every table has createdAt/updatedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth / users
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  MECHANIC
  ATTENDANT
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ATTENDANT)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  stockMovements StockMovement[]
  uploadedImages WorkOrderImage[]
  registeredPickups VehiclePickup[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Customers + Vehicles (Fase 2 — spec §17/§34)
// Catalogs use soft delete: `active` flag (logical deactivation, visible as
// "inactive" in the UI) + `deletedAt` (soft delete — record disappears from
// lists but stays for historical work orders, spec §35).
// ─────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  cpf       String    @unique
  phone     String
  email     String?
  address   String?
  notes     String?
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicles Vehicle[]
  appointments Appointment[]
  workOrders WorkOrder[]

  @@index([name])
  @@map("customers")
}

model Vehicle {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plate      String    @unique
  brand      String
  model      String
  year       Int?
  color      String?
  mileage    Int?
  active     Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  appointments Appointment[]
  workOrders WorkOrder[]

  @@index([customerId])
  @@map("vehicles")
}

// ─────────────────────────────────────────────────────────────
// Catalogs + stock (Fase 3 — spec §17/§34/§35/§36)
// Money is ALWAYS integer cents. Catalogs use soft delete (active/deletedAt).
// Every stock change goes through StockService inside a transaction (§36).
// ─────────────────────────────────────────────────────────────

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Service {
  id               String   @id @default(cuid())
  name             String
  description      String?
  priceCents       Int
  estimatedMinutes Int?
  active           Boolean  @default(true)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments Appointment[]
  workOrderServiceItems WorkOrderServiceItem[]

  @@index([name])
  @@map("services")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  cnpj      String    @unique // stored as bare 14 digits
  phone     String
  email     String?
  address   String?
  notes     String?
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@map("suppliers")
}

model Product {
  id             String   @id @default(cuid())
  code           String   @unique // normalized uppercase
  name           String
  description    String?
  costPriceCents Int
  salePriceCents Int
  stockQuantity  Int      @default(0)
  minStock       Int      @default(0)
  location       String?
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active         Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockMovements StockMovement[]
  workOrderProductItems WorkOrderProductItem[]

  @@index([name])
  @@index([supplierId])
  @@map("products")
}

model StockMovement {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Int // IN: added / OUT: removed / ADJUSTMENT: new absolute stock
  reason        String
  previousStock Int // snapshot for auditability (spec §36)
  newStock      Int
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// Appointments (Fase 4 — spec §13: conflito verificado no backend)
// Um veículo não pode ter dois agendamentos ativos no mesmo horário.
// ─────────────────────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([vehicleId, scheduledAt])
  @@index([customerId])
  @@index([scheduledAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────
// Work Orders (Fase 5 — spec §11/§35/§36)
// Items carry SNAPSHOTS of name/price at execution time: editing the catalog
// never rewrites an old OS. Every stock OUT goes through a transaction that
// also records the StockMovement (§36).
// ─────────────────────────────────────────────────────────────

model WorkOrder {
  id             String          @id @default(cuid())
  // Sequential number generated by the service layer (SQLite cannot
  // autoincrement a non-id column): MAX(orderNumber)+1 inside the creation
  // transaction. Starts at 1000 for a professional look.
  orderNumber    Int             @unique
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId      String
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  status         WorkOrderStatus @default(OPEN)
  notes          String?
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  serviceItems   WorkOrderServiceItem[]
  productItems   WorkOrderProductItem[]
  images         WorkOrderImage[]
  pickup         VehiclePickup?

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("work_orders")
}

enum WorkOrderStatus {
  OPEN
  IN_ASSESSMENT
  AWAITING_APPROVAL
  APPROVED
  IN_EXECUTION
  AWAITING_PARTS
  COMPLETED
  AWAITING_PICKUP
  DELIVERED
  CANCELLED
}

/// Snapshot rows (§35): copy of catalog data at insert time.
model WorkOrderServiceItem {
  id             String   @id @default(cuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceName    String // snapshot
  unitPriceCents Int // snapshot
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  @@index([workOrderId])
  @@map("work_order_service_items")
}

model WorkOrderProductItem {
  id             String   @id @default(cuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String // snapshot
  unitPriceCents Int // snapshot (sale price at insert)
  quantity       Int
  discountCents  Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([workOrderId])
  @@map("work_order_product_items")
}

// ─────────────────────────────────────────────────────────────
// Images (Fase 6 — spec: bytes no disco via StorageService, metadados no DB)
// Files live under STORAGE_DIR keyed by content sha256 (dedup by content);
// the DB row keeps mime/size/sha256 for safe serving.
// ─────────────────────────────────────────────────────────────

model WorkOrderImage {
  id          String   @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  storageKey  String // relative path under STORAGE_DIR (sha256[0:2]/sha256)
  sha256      String
  mimeType    String // validated against an allowlist at upload
  sizeBytes   Int
  caption     String?
  uploadedBy  String?
  uploadedByUser User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([workOrderId])
  @@map("work_order_images")
}

// ─────────────────────────────────────────────────────────────
// Vehicle pickup/delivery (Fase 7): 1─1 with the work order. Registered when
// the vehicle leaves the shop (AWAITING_PICKUP → DELIVERED in ONE transaction).
// ─────────────────────────────────────────────────────────────

model VehiclePickup {
  id            String   @id @default(cuid())
  workOrderId   String   @unique // 1─1 (spec §17)
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  receiverName  String
  receiverDoc   String // CPF/CNH bare digits
  receiverPhone String?
  mileageKm     Int?
  signatureData String? // base64 PNG from the signature pad (optional)
  notes         String?
  registeredBy  String?
  registeredByUser User? @relation(fields: [registeredBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@map("vehicle_pickups")
}

// ─────────────────────────────────────────────────────────────
// Offline-first sync foundation (spec §39)
// Services append domain operations here; the future sync worker
// drains this queue to a central server when online.
// ─────────────────────────────────────────────────────────────

model SyncOutbox {
  id        String    @id @default(cuid())
  entity    String
  entityId  String
  operation String // CREATE | UPDATE | DELETE
  payload   String? // JSON snapshot, no PII beyond what sync requires
  createdAt DateTime  @default(now())
  syncedAt  DateTime?

  @@index([syncedAt])
  @@index([entity, entityId])
  @@map("sync_outbox")
}

// ─────────────────────────────────────────────────────────────
// Shop settings (Bloco F2 mínimo — docs/todo-mvp.md): singleton row used by
// the printed documents (work order + pickup receipt headers/footers).
// Money-free, PII-free; upserted by the settings module.
// ─────────────────────────────────────────────────────────────

model ShopSettings {
  id          String  @id @default(cuid())
  name        String
  phone       String?
  address     String?
  documentFooter String?
  updatedAt   DateTime @updatedAt

  @@map("shop_settings")
}

// ─────────────────────────────────────────────────────────────
// Audit (spec §26) — critical events, no PII in payload
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   String?
  createdAt  DateTime  @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
