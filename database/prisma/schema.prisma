// Mechanic System — database schema (spec §17)
// Conventions:
//  - Money is ALWAYS integer cents (Int) — never float (spec §18)
//  - Soft delete via deletedAt + active flag on catalogs (spec §34)
//  - Historical snapshots live on work order items (spec §35)
//  - Every table has createdAt/updatedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth / users
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  MECHANIC
  ATTENDANT
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ATTENDANT)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  stockMovements StockMovement[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Customers + Vehicles (Fase 2 — spec §17/§34)
// Catalogs use soft delete: `active` flag (logical deactivation, visible as
// "inactive" in the UI) + `deletedAt` (soft delete — record disappears from
// lists but stays for historical work orders, spec §35).
// ─────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  cpf       String    @unique
  phone     String
  email     String?
  address   String?
  notes     String?
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicles Vehicle[]

  @@index([name])
  @@map("customers")
}

model Vehicle {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plate      String    @unique
  brand      String
  model      String
  year       Int?
  color      String?
  mileage    Int?
  active     Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
  @@map("vehicles")
}

// ─────────────────────────────────────────────────────────────
// Catalogs + stock (Fase 3 — spec §17/§34/§35/§36)
// Money is ALWAYS integer cents. Catalogs use soft delete (active/deletedAt).
// Every stock change goes through StockService inside a transaction (§36).
// ─────────────────────────────────────────────────────────────

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model Service {
  id               String   @id @default(cuid())
  name             String
  description      String?
  priceCents       Int
  estimatedMinutes Int?
  active           Boolean  @default(true)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([name])
  @@map("services")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  cnpj      String    @unique // stored as bare 14 digits
  phone     String
  email     String?
  address   String?
  notes     String?
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@map("suppliers")
}

model Product {
  id             String   @id @default(cuid())
  code           String   @unique // normalized uppercase
  name           String
  description    String?
  costPriceCents Int
  salePriceCents Int
  stockQuantity  Int      @default(0)
  minStock       Int      @default(0)
  location       String?
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active         Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([name])
  @@index([supplierId])
  @@map("products")
}

model StockMovement {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Int // IN: added / OUT: removed / ADJUSTMENT: new absolute stock
  reason        String
  previousStock Int // snapshot for auditability (spec §36)
  newStock      Int
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// Offline-first sync foundation (spec §39)
// Services append domain operations here; the future sync worker
// drains this queue to a central server when online.
// ─────────────────────────────────────────────────────────────

model SyncOutbox {
  id        String    @id @default(cuid())
  entity    String
  entityId  String
  operation String // CREATE | UPDATE | DELETE
  payload   String? // JSON snapshot, no PII beyond what sync requires
  createdAt DateTime  @default(now())
  syncedAt  DateTime?

  @@index([syncedAt])
  @@index([entity, entityId])
  @@map("sync_outbox")
}

// ─────────────────────────────────────────────────────────────
// Audit (spec §26) — critical events, no PII in payload
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   String?
  createdAt  DateTime  @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
