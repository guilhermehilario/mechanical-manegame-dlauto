# ============================================================
# Mechanic System - Environment configuration
# Copy to .env and adjust values. NEVER commit real secrets.
# ============================================================

# --- API -----------------------------------------------------
# Port used by the NestJS API (bound to 127.0.0.1 only)
API_PORT=3001
# Origins allowed to call the API (Electron renderer / dev server)
CORS_ORIGIN=http://localhost:5173

# --- Authentication ------------------------------------------
# OpenSSL: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-with-48-random-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-with-48-random-bytes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Database ------------------------------------------------
# SQLite path is resolved RELATIVE to database/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Rate limiting -------------------------------------------
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60

# --- Development seed (pnpm db:seed) -------------------------
# R4/SEC-04: NO default credentials ship with this project. The seed and the
# smoke test REQUIRE these values — choose your own local admin.
SEED_ADMIN_EMAIL=admin@oficina.local
SEED_ADMIN_PASSWORD=choose-a-strong-local-password

# --- First-run admin (packaged desktop app) ------------------
# Used ONLY when the database has no ADMIN yet (installed product's first run).
#FIRST_RUN_ADMIN_EMAIL=admin@oficina.local
#FIRST_RUN_ADMIN_PASSWORD=first-run-password

# --- App -----------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
